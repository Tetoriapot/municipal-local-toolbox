{
  "name": "municipal-local-toolbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/build-tools.mjs && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify-build.mjs",
    "tools:build": "node scripts/build-tools.mjs",
    "test:e2e": "playwright test",
    "test:ui": "node scripts/inspect-ui.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "typescript": "5.9.3"
  }
}
