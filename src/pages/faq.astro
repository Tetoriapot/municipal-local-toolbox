---
import ArticleLayout from '../layouts/ArticleLayout.astro';
const questions = [
  ['インストールは必要ですか？', '利用者によるソフトウェアのインストールは不要です。保存したHTMLファイルを対応ブラウザで開きます。'],
  ['インターネット接続は必要ですか？', 'サイトの閲覧・ダウンロードには通信が必要です。保存した配布ツールの起動・利用には接続は不要です。'],
  ['入力内容は送信されますか？', '配布ツールに入力した記録やメモをサーバーへ送信する機能はありません。ブラウザ内に保存します。'],
  ['TXT版はどう使いますか？', 'ファイルを保存し、拡張子 .txt を .html に変更してからブラウザで開きます。ファイル名拡張子を表示して、.html.txt になっていないか確認してください。'],
  ['保存したデータはどこにありますか？', '利用中のブラウザのlocalStorageに保存します。入力内容がHTMLファイルへ書き込まれるわけではありません。ファイルを移動・改名した場合などは、保存データを参照できなくなることがあります。'],
  ['PCを変更したらデータは移りますか？', '自動では移りません。元のPCでJSONバックアップを書き出し、移動先で同じツールを開いて読み込んでください。所属組織で許可された移動方法を利用してください。'],
  ['Edgeで動きますか？', 'Microsoft EdgeとGoogle Chromeの最新版を主要な対応対象としています。Internet Explorerは非対応です。組織の設定によって、ローカルファイルの起動や保存が制限されることがあります。'],
  ['「未保存」と表示されたら？', 'ブラウザが保存を禁止している、または保存領域が不足している可能性があります。画面を閉じる前にJSONバックアップを書き出してください。'],
  ['配布確認版で実際の業務を管理できますか？', '現時点では、起動、メモの保存、JSONバックアップ、印刷の確認用です。各ツール固有の業務機能は実装予定です。実際の業務データは入力しないでください。'],
  ['複数人で同時編集できますか？', '共有サーバーや同期機能はありません。JSONを渡すことはできますが、読込み時に現在の内容を置き換えます。自動マージや同時編集はできません。'],
  ['無料で使えますか？', '配布ツールは無料で利用できます。現時点の利用条件は利用規約をご確認ください。正式なライセンスは公開前に確定する予定です。'],
];
---
<ArticleLayout title="よくある質問" eyebrow="FAQ" lead="起動、保存、バックアップに関する質問と回答です。"><div class="faq-list">{questions.map(([question, answer]) => <details><summary>{question}</summary><div><p>{answer}</p></div></details>)}</div></ArticleLayout>
