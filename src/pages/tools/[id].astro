---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import DownloadButtons from '../../components/DownloadButtons.astro';
import SafetyTable from '../../components/SafetyTable.astro';
import { tools } from '../../data/tools';
import { categoryById } from '../../data/categories';
import { url } from '../../lib/paths';
export function getStaticPaths() { return tools.map(tool => ({ params: { id: tool.id }, props: { tool } })); }
const { tool } = Astro.props;
const ready = tool.status === 'ready';
---
<BaseLayout title={tool.name} description={`${tool.summary} TXT・HTML形式で配布。${ready ? '業務機能を実装しています。' : '配布確認版です。業務機能は開発予定です。'}`}><div class="container">
  <nav class="breadcrumb" aria-label="パンくず"><a href={url('/')}>ホーム</a><Icon name="chevron" size={12} /><a href={url('/tools/')}>ツール一覧</a><Icon name="chevron" size={12} /><span aria-current="page">{tool.name}</span></nav>
  <div class="detail-heading"><span class={`tool-icon tone-${tool.category}`}><Icon name={tool.icon} size={37} /></span><div><a class="category-label" href={url(`/categories/${tool.category}/`)}>{categoryById(tool.category).name}</a><h1>{tool.name}</h1><div class="detail-subtitle">{ready ? '業務機能を実装済み' : '配布確認版'} v{tool.version} <span aria-hidden="true"> · </span> 更新 <time datetime={tool.updatedAt}>{tool.updatedAt.replaceAll('-', '.')}</time></div></div></div>
  <div class="detail-layout"><div><p class="detail-summary">{tool.summary}</p><div class="tags">{tool.tags.map(tag => <span>{tag}</span>)}</div>
    <section class="detail-section"><h2>{ready ? '利用場面' : '想定する利用場面'}</h2><ul class="usecase-list">{tool.useCases.map(item => <li>{item}</li>)}</ul></section>
    <section class="detail-section"><h2>主な機能 {!ready && <span class="fine">／ 実装予定</span>}</h2><ul class="feature-list">{tool.features.map(feature => <li><Icon name={ready ? 'check' : 'chevron'} size={16} />{feature}</li>)}</ul>{ready && <p class="fine" style="margin-top:16px">{tool.implementation?.featureNote}</p>}</section>
    <section class="detail-section"><h2>保存・出力機能</h2><p class="muted">{ready ? tool.implementation?.storageDescription : '配布確認版には、自由記入のメモと共通のデータ管理機能を用意しています。'}</p><ul class="feature-list">{['単一HTMLのオフライン起動',ready ? '記録・メモのブラウザ内自動保存' : 'メモのブラウザ内自動保存','JSONバックアップの書出し・読込み',ready ? tool.implementation?.printLabel : 'メモの印刷','保存状態・保存失敗の表示','削除時の確認', ...(tool.implementation?.extraOutputs ?? [])].map(feature => <li><Icon name="check" size={17} />{feature}</li>)}</ul><p class="fine" style="margin-top:18px">{tool.demo ? 'サンプルで操作を試せます。画面のスクリーンショットは準備中です。' : '画面のスクリーンショット・サンプルデータ付きデモは準備中です。'}</p></section>
    <section class="detail-section"><h2>安全仕様</h2><SafetyTable /><p class="fine" style="margin-top:16px">この表はダウンロードしたツールの仕様です。配布サイトの閲覧・ファイル取得には通信が発生します。</p><div class="notice">個人情報・機密情報を入力する場合は所属組織の情報セキュリティポリシーを確認してください。</div><a class="text-link" href={url('/safety/')}>安全性について詳しく見る <Icon name="arrow" size={17} /></a></section>
    <section class="detail-section"><h2>TXT版とは？</h2><p>HTMLファイルと同じ内容を、テキストファイルとして配布しています。保存後、拡張子を変更するとブラウザで開けます。</p><div class="file-conversion"><code>{tool.id}.txt</code><Icon name="arrow" size={21} /><strong><code>{tool.id}.html</code></strong></div><p class="fine" style="margin-top:13px">拡張子が表示されない場合や、メモ帳で開いてしまう場合は、変更方法をご確認ください。</p><a class="text-link" href={url('/guide/txt-to-html/')}>TXT → HTML の変更方法 <Icon name="arrow" size={17} /></a></section>
    <a class="text-link back-link" href={url('/tools/')}>ツール一覧に戻る <Icon name="arrow" size={17} /></a>
  </div><DownloadButtons tool={tool} /></div>
</div></BaseLayout>
