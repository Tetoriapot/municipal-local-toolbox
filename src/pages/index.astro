---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SearchBox from '../components/SearchBox.astro';
import ToolCard from '../components/ToolCard.astro';
import { distributionSummary, tools } from '../data/tools';
import { categories } from '../data/categories';
import { url } from '../lib/paths';
const recommended = ['handover-note', 'equipment-manager', 'lending-manager', 'annual-calendar'].map(id => tools.find(tool => tool.id === id)!);
const features = [
  { icon: 'monitor', title: 'インストール不要', text: '保存したHTMLファイルをブラウザで開いて使用します。追加のソフトウェアは不要です。' },
  { icon: 'offline', title: '外部通信なし', text: '入力情報を外部に送信しません。保存したツールはオフラインで起動できます。' },
  { icon: 'file', title: 'TXTでも配布', text: 'HTMLを直接保存できない環境を想定。テキストファイルからも利用できます。' },
  { icon: 'code', title: 'ソース確認可能', text: 'TXT版を開いてソースコードを確認できます。利用前の技術確認に使用してください。' },
];
---
<BaseLayout>
  <section class="hero"><div class="container hero-inner">
    <div><p class="hero-kicker"><span></span> 自治体・公共団体向けの無料業務ツール</p><h1>自治体の業務を<br /><em>ブラウザで</em>管理。</h1><p class="hero-copy">インストール不要。通信不要。<br />データをPC内に保存する単一HTMLツール。</p><div class="hero-actions"><a class="button button-primary" href={url('/tools/')}>ツールを探す <Icon name="arrow" size={18} /></a><a class="button button-outline" href={url('/guide/')}><Icon name="book" size={18} /> 使い方を見る</a></div><p class="hero-notes"><span><Icon name="check" size={14} /> アカウント登録不要</span><span><Icon name="check" size={14} /> PC内でデータを管理</span></p></div>
    <aside class="handover-overview" aria-label="異動引継ぎノートの実装状況">
      <span class="eyebrow">業務機能を実装済み · v{tools.find(tool => tool.id === 'handover-note')!.version}</span>
      <h2>異動引継ぎノート</h2><p>6分類の記録を登録し、引継ぎの確認状況を管理します。</p>
      <ul>{[['notebook', '担当業務'], ['calendar', '年間予定'], ['users', '関係者'], ['file', '資料の保存場所'], ['message', '申し送り'], ['check', 'チェックリスト']].map(([icon, label]) => <li><Icon name={icon} size={21} />{label}</li>)}</ul>
      <a class="button button-outline" href={url('/tools/handover-note/')}>機能とダウンロード <Icon name="arrow" size={18} /></a>
    </aside>
  </div></section>
  <div class="trust-strip"><div class="container trust-inner">{[{icon:'monitor',label:'インストール不要'},{icon:'shield',label:'データの外部送信なし'},{icon:'file',label:'TXT・HTMLで配布'},{icon:'code',label:'外部ライブラリ不要'}].map(item => <div class="trust-item"><Icon name={item.icon} size={21} />{item.label}</div>)}</div></div>
  <section class="container search-section" aria-labelledby="find-title"><div class="search-intro"><h2 id="find-title">業務名・機能で検索</h2><span>ツール名・キーワードで検索できます</span></div><SearchBox /><p class="search-examples"><span>よく使うキーワード</span>{['引継ぎ','備品','年間予定','会議','CSV'].map(word => <a href={url(`/tools/?q=${encodeURIComponent(word)}`)}>{word}</a>)}</p></section>
  <section class="section section-soft"><div class="container"><div class="section-heading"><div><span class="eyebrow">PICK UP TOOLS</span><h2>主な配布ツール</h2><p>各ツールの機能と実装状況を確認できます。</p></div><a class="text-link" href={url('/tools/')}>すべて見る <Icon name="arrow" size={18} /></a></div><div class="tool-grid">{recommended.map(tool => <ToolCard tool={tool} />)}</div><p class="catalog-note">{distributionSummary}</p></div></section>
  <section class="section"><div class="container"><div class="section-heading"><div><span class="eyebrow">CATEGORIES</span><h2>業務の種類から探す</h2></div><a class="text-link" href={url('/categories/')}>カテゴリ一覧 <Icon name="arrow" size={18} /></a></div><div class="category-grid">{categories.map(category => <a class="category-chip" href={url(`/categories/${category.id}/`)}><Icon name={category.icon} size={24} /><span>{category.name}</span><small>{tools.filter(tool => tool.category === category.id).length}</small></a>)}</div></div></section>
  <section class="section section-soft"><div class="container"><div class="section-heading"><div><span class="eyebrow">SIMPLE & LOCAL</span><h2>配布ツールの仕様</h2><p>導入方法、通信、配布形式、ソース確認について。</p></div></div><div class="features-grid">{features.map(feature => <div class="feature"><Icon name={feature.icon} size={31} /><h3>{feature.title}</h3><p>{feature.text}</p></div>)}</div><a class="text-link" href={url('/safety/')}>データの取り扱いと安全性について <Icon name="arrow" size={18} /></a></div></section>
  <div class="container"><section class="guide-banner"><div><span class="eyebrow">GETTING STARTED</span><h2>ダウンロードから起動まで</h2><p>保存方法とTXT版の拡張子変更を説明します。</p></div><a class="button button-outline" href={url('/guide/')}>初めての方へ <Icon name="arrow" size={18} /></a></section><section class="news"><h2>お知らせ</h2><div class="news-row"><time datetime="2026-10-05">2026.10.05</time><span class="news-label">開発のお知らせ</span><a href={url('/changelog/')}>配色切替・下書き・サンプル・CSV読込みを追加しました。 <Icon name="chevron" size={14} /></a></div></section></div>
</BaseLayout>
