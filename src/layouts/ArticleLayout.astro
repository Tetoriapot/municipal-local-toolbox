---
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { url } from '../lib/paths';
interface Props { title: string; lead?: string; eyebrow?: string; }
const { title, lead, eyebrow = 'INFORMATION' } = Astro.props;
---
<BaseLayout title={title}><div class="container article-layout"><nav class="breadcrumb" aria-label="パンくず"><a href={url('/')}>ホーム</a><Icon name="chevron" size={12} /><span aria-current="page">{title}</span></nav><div class="page-heading"><span class="eyebrow">{eyebrow}</span><h1>{title}</h1>{lead && <p>{lead}</p>}</div><div class="article-body"><slot /></div></div></BaseLayout>
